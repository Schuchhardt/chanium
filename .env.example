# Copy to .env.local and fill in. The site builds and renders with none of these set;
# the quote and waitlist APIs degrade gracefully (logged, not stored) until they are.

# Site
NEXT_PUBLIC_SITE_URL=https://chanium.com

# Supabase — quotes, waitlist, proposal PDFs (bucket "proposals"). Service role is server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — proposal pipeline
ANTHROPIC_API_KEY=

# Resend — proposal + internal emails
RESEND_API_KEY=
QUOTE_FROM_EMAIL="Chanium <hello@chanium.com>"
INTERNAL_NOTIFY_EMAIL=hello@chanium.com

# Cal.com booking link included in the proposal email
CAL_BOOKING_URL=

# Optional: Slack incoming webhook for new-quote summaries
SLACK_WEBHOOK_URL=

# Optional: Upstash Redis for rate limiting /api/quote and /api/waitlist.
# Without it, an in-memory limiter is used (per serverless instance only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
